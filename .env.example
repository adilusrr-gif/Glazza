# Run python scripts/setup.py; never use these placeholders as credentials.
GLAZZA_ADMIN=admin
GLAZZA_PASSWORD=
GLAZZA_WORKER_KEY=
GLAZZA_DEMO=false
GLAZZA_DATA_DIR=./data
GLAZZA_UID=10001
GLAZZA_GID=10001
GLAZZA_BIND=127.0.0.1
GLAZZA_PORT=8080
GLAZZA_SECURE_COOKIE=false
GLAZZA_RETENTION_DAYS=30
GLAZZA_ACTION_THRESHOLD=0.75
GLAZZA_FIGHT_THRESHOLD=0.8
GLAZZA_TORCH_THREADS=2
GLAZZA_FIGHT_WINDOWS=3
# Compose uses the internal mqtt service; no broker port is published.
GLAZZA_MQTT_HOST=mqtt
GLAZZA_MQTT_PORT=1883
GLAZZA_MQTT_PREFIX=frigate
# Optional: sends restaurant alerts only to configured staff chat IDs.
GLAZZA_TELEGRAM_BOT_TOKEN=
